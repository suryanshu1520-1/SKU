{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": false,
    "noEmit": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["./**/*.ts", "./**/*.tsx", "../types/**/*.d.ts"]
}
