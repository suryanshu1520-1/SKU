{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suryanshu1520-1/tark.git"
  },
  "homepage": "https://github.com/suryanshu1520-1/tark#readme",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsx scripts/generate-sitemap.ts && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint:web": "tsc --noEmit",
    "lint:api": "tsc -p api/tsconfig.json --noEmit",
    "lint": "npm run lint:web && npm run lint:api",
    "test": "tsx --test scripts/test-rebase-contract.ts src/lib/vulnerabilityIndex.test.ts src/lib/study-library.test.ts src/lib/syllabus-mapping.test.ts src/lib/examiner-psyche-view.test.ts scripts/tests/examiner_psyche.test.ts scripts/tests/analytics-security.test.ts scripts/tests/syllabus-api.test.ts scripts/tests/serverless-graph.test.ts scripts/tests/article-exam-insights.test.ts scripts/tests/international-baseline.test.ts scripts/tests/international-phase2.test.ts scripts/tests/international-phase3.test.ts && npm run test:exam && npm run test:qbank && npm run test:radar",
    "test:international": "tsx --test scripts/tests/international-baseline.test.ts scripts/tests/international-phase2.test.ts scripts/tests/international-phase3.test.ts",
    "test:exam": "tsx --test scripts/exam-tests/grading.test.ts scripts/exam-tests/assemble.test.ts scripts/exam-tests/sanitize.test.ts scripts/exam-tests/clock.test.ts scripts/exam-tests/sheetReducer.test.ts scripts/exam-tests/itemLayout.test.ts scripts/exam-tests/interpret.test.ts scripts/exam-tests/sessionHelpers.test.ts",
    "test:qbank": "tsx --test scripts/qbank-tests/validators.test.ts \"scripts/qbank-tests/final/**/*.test.ts\"",
    "qbank:census": "tsx scripts/qbank/final/census.ts",
    "qbank:acquire": "tsx scripts/qbank/final/acquire.ts",
    "qbank:profile": "python -X utf8 scripts/qbank/final/py/profile_docs.py",
    "qbank:import-handoff": "tsx scripts/qbank/final/import-handoff.ts",
    "qbank:extract-table": "python -X utf8 scripts/qbank/final/py/extract_table.py",
    "qbank:extract-linear": "python -X utf8 scripts/qbank/final/py/extract_linear.py",
    "qbank:extract-mains": "python -X utf8 scripts/qbank/final/py/extract_mains.py",
    "qbank:parse": "python -X utf8 scripts/qbank/final/py/parse_items.py",
    "qbank:reconcile": "tsx scripts/qbank/final/reconcile.ts",
    "qbank:crops": "python -X utf8 scripts/qbank/final/py/crops.py",
    "qbank:review": "tsx scripts/qbank/final/review.ts",
    "qbank:release": "tsx scripts/qbank/final/release.ts",
    "qbank:load": "tsx scripts/qbank/final/load.ts",
    "qbank:parity": "tsx scripts/qbank/final/parity.ts",
    "test:qbank:py": "python -X utf8 -m unittest discover -s scripts/qbank/final/py -p \"test_*.py\"",
    "test:radar": "tsx --test \"scripts/tests/radar/**/*.test.ts\""
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/merriweather": "^5.2.11",
    "@fontsource/playfair-display": "^5.2.8",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@types/katex": "^0.16.8",
    "@vercel/functions": "^3.7.1",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.17.0",
    "canvas": "^3.2.3",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "fast-xml-parser": "^5.8.0",
    "got-scraping": "^4.2.1",
    "katex": "^0.18.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.2.108",
    "razorpay": "^2.9.6",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "rss-parser": "^3.13.0",
    "turndown": "^7.2.4",
    "vite": "^6.2.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@gradio/client": "^2.2.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "supabase": "^2.105.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
