# ==========================================
# Tark 1.0 — Comprehensive .gitignore
# ==========================================

# ── Secrets, API Keys & Environment Configs ──
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
!.env.example
.mcp.json
*.pem
*.key
*.cert
*.pfx
*.p12
*.id_rsa
id_rsa*

# ── Obsidian Secrets & Local Workspace Clutter ──
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/plugins/obsidian-local-rest-api/data.json
.obsidian/plugins/*/data.json

# ── Dependencies ──
node_modules/
.pnp
.pnp.js

# ── Build & Server Outputs ──
dist/
dist-server/
build/
out/
.next/
.nuxt/
.turbo/
.vercel/

# ── Logs & Debug Traces ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Diagnostics & Test Artifacts ──
coverage/
*.lcov
test-output.md
ts_trace.txt
*.tsbuildinfo
.cache/

# ── Operating System Clutter ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── IDE & Editor State ──
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
*.tmp
*.bak

# ── Agent handoffs, briefs & inboxes (internal orchestration — NEVER public) ──
# Cross-agent task briefs (Claude ⇄ Antigravity) are internal process artifacts.
# They can contain roadmaps, credentials for tests, or candid security notes.
# NOTE: .agents/skills/ (installed agent skills) stays tracked — only the
# inbox (handoffs) and standalone *-handoff.md files are excluded.
docs/handoffs/
.agents/inbox/
*-handoff.md
*.handoff.md

# ── Internal research (strategic deep-research inputs — kept local, not public) ──
# Lives in the Obsidian vault for reference/synthesis; not pushed to the public repo.
docs/research/

# ── Scratch & verification throwaways (probes, dry-runs, temp tsconfigs) ──
_scratch/
*.probe.mjs
*-probe.mjs
*-probe.ts
*-dryrun.ts
*-dryrun.mjs
*.dryrun.*
cluster-test.ts
tsconfig.verify*.json

# ── Raw Source Archive (Local OCR & raw data — NEVER pushed to git) ──
_raw_source_archive/
_raw_source_archive/*