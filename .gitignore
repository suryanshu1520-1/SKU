# ==========================================
# Tark 1.0 — Comprehensive .gitignore
# ==========================================

# ── Secrets, API Keys & Environment Configs ──
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
!.env.example
.mcp.json
*.pem
*.key
*.cert
*.pfx
*.p12
*.id_rsa
id_rsa*

# ── Obsidian Secrets & Local Workspace Clutter ──
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/plugins/obsidian-local-rest-api/data.json
.obsidian/plugins/*/data.json

# ── Dependencies ──
node_modules/
.pnp
.pnp.js

# ── Build & Server Outputs ──
dist/
dist-server/
build/
out/
.next/
.nuxt/
.turbo/
.vercel/

# ── Logs & Debug Traces ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Diagnostics & Test Artifacts ──
coverage/
*.lcov
test-output.md
ts_trace.txt
*.tsbuildinfo
.cache/

# ── Operating System Clutter ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── IDE & Editor State ──
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
*.tmp
*.bak