# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# === Supabase Configuration ===
# Get from: https://app.supabase.com/project/[project-id]/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc... # Service role (server-side only)
SUPABASE_ANON_KEY=eyJhbGc...         # Anon key (client-side)

# Frontend expects these with VITE_ prefix
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGc...

# === Gemini AI Configuration ===
# Get from: https://ai.google.dev/
GEMINI_API_KEY=AIza... # Used for /api/insights endpoint

# === Razorpay Configuration ===
# Get from: https://dashboard.razorpay.com/settings/api-keys
# For testing, use rzp_test_* keys. For production, use rzp_live_* keys.
RAZORPAY_KEY_ID=rzp_test_1234567890
RAZORPAY_KEY_SECRET=your-razorpay-secret-key

# Frontend expects Razorpay key with VITE_ prefix (anon, so test key is okay)
VITE_RAZORPAY_KEY_ID=rzp_test_1234567890

# === Internal Security ===
# Use any strong random string; used for validating cron worker requests
INTERNAL_WORKER_SECRET=tark_super_secret_key_2026_!@#
CRON_SECRET=your-cron-secret-here

# === Optional: AI Endpoints ===
# If using HuggingFace or custom model endpoints for fallback
AI_ENDPOINT_URL=https://your-hf-endpoint.space/api/chat_fn
GROQ_API_KEY=gsk_... # Optional Groq fallback

# === Runtime (usually don't need to change) ===
NODE_ENV=development
PORT=3000
