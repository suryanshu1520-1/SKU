{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/server" },
    { "source": "/sitemap-news.xml", "destination": "/api/server" },
    { "source": "/intelligence", "destination": "/api/server" },
    { "source": "/intelligence/(.*)", "destination": "/api/server" },
    { "source": "/news", "destination": "/api/server" },
    { "source": "/news/(.*)", "destination": "/api/server" },
    { "source": "/prs", "destination": "/api/server" },
    { "source": "/prs/(.*)", "destination": "/api/server" },
    { "source": "/daily-edition", "destination": "/api/server" },
    { "source": "/daily-edition/(.*)", "destination": "/api/server" },
    { "source": "/api/(.*)", "destination": "/api/server" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/server.ts": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/newsdata",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/reset-leaderboard",
      "schedule": "30 8 * * 0"
    }
  ]
}